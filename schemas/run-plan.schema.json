{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuki777/pr-codex/blob/main/schemas/run-plan.schema.json",
  "title": "pr-codex run-plan artifact",
  "description": "Preflight and post-run execution metadata for /pr-codex:review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files_changed",
    "hunks",
    "lines_added",
    "lines_removed",
    "risk_tags",
    "selected_hunters",
    "depth_actual",
    "depth_source",
    "depth_reason",
    "depth_requested",
    "depth_downgraded",
    "depth_downgrade_reason",
    "recommended_mode",
    "skip_reason",
    "estimated_stages",
    "estimated_timeout_ms",
    "actual_duration_ms",
    "actual_tokens"
  ],
  "properties": {
    "files_changed": {
      "type": "integer",
      "minimum": 0
    },
    "hunks": {
      "type": "integer",
      "minimum": 0
    },
    "lines_added": {
      "type": "integer",
      "minimum": 0
    },
    "lines_removed": {
      "type": "integer",
      "minimum": 0
    },
    "risk_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "security",
          "data_migration",
          "dependency",
          "infra",
          "test_touch",
          "api_contract"
        ]
      },
      "uniqueItems": true
    },
    "selected_hunters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "claude",
          "codex"
        ]
      }
    },
    "depth_actual": {
      "type": "string",
      "enum": [
        "deep",
        "standard"
      ]
    },
    "depth_source": {
      "type": "string",
      "enum": [
        "argument",
        "auto",
        "default"
      ]
    },
    "depth_reason": {
      "type": "string",
      "minLength": 1
    },
    "depth_requested": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "deep",
        "standard",
        null
      ]
    },
    "depth_downgraded": {
      "type": "boolean"
    },
    "depth_downgrade_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommended_mode": {
      "type": "string",
      "enum": [
        "standard",
        "focused",
        "skip"
      ]
    },
    "skip_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "estimated_stages": {
      "type": "integer",
      "minimum": 1
    },
    "estimated_timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "actual_duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "actual_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recommended_mode": {
            "const": "skip"
          }
        },
        "required": [
          "recommended_mode"
        ]
      },
      "then": {
        "properties": {
          "skip_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "skip_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_source": {
            "const": "argument"
          }
        },
        "required": [
          "depth_source"
        ]
      },
      "then": {
        "properties": {
          "depth_requested": {
            "type": "string",
            "enum": [
              "deep",
              "standard"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "depth_requested": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_downgraded": {
            "const": true
          }
        },
        "required": [
          "depth_downgraded"
        ]
      },
      "then": {
        "properties": {
          "depth_actual": {
            "const": "standard"
          },
          "depth_source": {
            "const": "argument"
          },
          "depth_requested": {
            "const": "deep"
          },
          "depth_downgrade_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "depth_downgrade_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_requested": {
            "const": "standard"
          }
        },
        "required": [
          "depth_requested"
        ]
      },
      "then": {
        "properties": {
          "depth_actual": {
            "const": "standard"
          },
          "depth_downgraded": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_requested": {
            "const": "deep"
          },
          "depth_downgraded": {
            "const": false
          }
        },
        "required": [
          "depth_requested",
          "depth_downgraded"
        ]
      },
      "then": {
        "properties": {
          "depth_actual": {
            "const": "deep"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_source": {
            "const": "auto"
          }
        },
        "required": [
          "depth_source"
        ]
      },
      "then": {
        "properties": {
          "depth_actual": {
            "const": "deep"
          },
          "depth_requested": {
            "type": "null"
          },
          "depth_downgraded": {
            "const": false
          },
          "depth_downgrade_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_source": {
            "const": "default"
          }
        },
        "required": [
          "depth_source"
        ]
      },
      "then": {
        "properties": {
          "depth_actual": {
            "const": "standard"
          },
          "depth_requested": {
            "type": "null"
          },
          "depth_downgraded": {
            "const": false
          },
          "depth_downgrade_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
