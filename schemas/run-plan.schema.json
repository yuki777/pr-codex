{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuki777/pr-codex/blob/main/schemas/run-plan.schema.json",
  "title": "pr-codex run-plan artifact",
  "description": "Preflight and post-run execution metadata for /pr-codex:review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files_changed",
    "hunks",
    "lines_added",
    "lines_removed",
    "risk_tags",
    "selected_hunters",
    "depth_actual",
    "depth_source",
    "depth_reason",
    "depth_requested",
    "depth_downgraded",
    "depth_downgrade_reason",
    "recommended_mode",
    "skip_reason",
    "routing_decision",
    "estimated_stages",
    "estimated_timeout_ms",
    "actual_duration_ms",
    "actual_tokens",
    "cost",
    "review_loop"
  ],
  "properties": {
    "files_changed": {
      "type": "integer",
      "minimum": 0
    },
    "hunks": {
      "type": "integer",
      "minimum": 0
    },
    "lines_added": {
      "type": "integer",
      "minimum": 0
    },
    "lines_removed": {
      "type": "integer",
      "minimum": 0
    },
    "risk_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "security",
          "data_migration",
          "dependency",
          "infra",
          "test_touch",
          "api_contract"
        ]
      },
      "uniqueItems": true
    },
    "selected_hunters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "claude",
          "codex"
        ]
      }
    },
    "depth_actual": {
      "type": "string",
      "enum": [
        "deep",
        "standard"
      ]
    },
    "depth_source": {
      "type": "string",
      "enum": [
        "argument",
        "auto",
        "default"
      ]
    },
    "depth_reason": {
      "type": "string",
      "minLength": 1
    },
    "depth_requested": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "deep",
        "standard",
        null
      ]
    },
    "depth_downgraded": {
      "type": "boolean"
    },
    "depth_downgrade_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommended_mode": {
      "type": "string",
      "enum": [
        "standard",
        "focused",
        "skip"
      ]
    },
    "skip_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "routing_decision": {
      "type": "object",
      "description": "Deterministic M2 logical routing decision. Route enum is intentionally narrow in M2 and may be extended by F4 specialist routing; provider/model names and private config must not be exposed.",
      "additionalProperties": false,
      "required": [
        "budget_class",
        "route",
        "model_profile",
        "rationale"
      ],
      "properties": {
        "budget_class": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "route": {
          "type": "string",
          "description": "Logical reviewer route. M2 emits claude+codex only; F4 may extend this enum for specialist routing.",
          "enum": [
            "claude+codex"
          ]
        },
        "model_profile": {
          "type": "string",
          "description": "Logical execution profile only; never a provider or concrete model name.",
          "enum": [
            "standard",
            "deep",
            "focused-fallback"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\r\\n]+$",
          "description": "Deterministic fact list built from files_changed, total_lines, risk_tags, depth_actual, and recommended_mode."
        }
      }
    },
    "estimated_stages": {
      "type": "integer",
      "minimum": 1
    },
    "estimated_timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "actual_duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "actual_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "review_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "halting_policy",
        "round_metrics"
      ],
      "properties": {
        "halting_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_rounds",
            "time_budget_ms",
            "no_new_evidence_rounds",
            "repeated_contradiction_limit",
            "verifier_fail_policy",
            "insufficient_evidence_policy"
          ],
          "properties": {
            "max_rounds": {
              "type": "integer",
              "minimum": 1
            },
            "time_budget_ms": {
              "type": "integer",
              "minimum": 0
            },
            "no_new_evidence_rounds": {
              "type": "integer",
              "minimum": 1
            },
            "repeated_contradiction_limit": {
              "type": "integer",
              "minimum": 1
            },
            "verifier_fail_policy": {
              "const": "local_artifact_only"
            },
            "insufficient_evidence_policy": {
              "const": "suppress_to_local_artifact"
            }
          }
        },
        "round_metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rounds_completed",
            "halt_reason",
            "verifier_fail_candidates",
            "suppressed_candidate_count",
            "no_new_evidence_rounds",
            "repeated_contradiction_events",
            "insufficient_evidence_events",
            "oscillation_detected"
          ],
          "properties": {
            "rounds_completed": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "halt_reason": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "max_rounds",
                "time_budget",
                "no_new_evidence",
                "repeated_contradiction",
                "all_candidates_verified",
                "no_active_candidates"
              ]
            },
            "verifier_fail_candidates": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "suppressed_candidate_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "no_new_evidence_rounds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "repeated_contradiction_events": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "insufficient_evidence_events": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "oscillation_detected": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "description": "Actual USD cost reported by provider/CLI output. This is never estimated from a repo-managed pricing table.",
      "additionalProperties": false,
      "required": [
        "actual_usd",
        "currency",
        "source",
        "components"
      ],
      "properties": {
        "actual_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "const": "USD"
        },
        "source": {
          "type": "string",
          "enum": [
            "provider_reported",
            "unavailable"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "actual_usd",
              "source"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "enum": [
                  "claude",
                  "codex"
                ]
              },
              "actual_usd": {
                "type": "number",
                "minimum": 0
              },
              "source": {
                "const": "cli_log"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recommended_mode": {
            "const": "skip"
          }
        },
        "required": [
          "recommended_mode"
        ]
      },
      "then": {
        "properties": {
          "skip_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "skip_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_source": {
            "const": "argument"
          }
        },
        "required": [
          "depth_source"
        ]
      },
      "then": {
        "properties": {
          "depth_requested": {
            "type": "string",
            "enum": [
              "deep",
              "standard"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "depth_requested": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_downgraded": {
            "const": true
          }
        },
        "required": [
          "depth_downgraded"
        ]
      },
      "then": {
        "properties": {
          "depth_actual": {
            "const": "standard"
          },
          "depth_source": {
            "const": "argument"
          },
          "depth_requested": {
            "const": "deep"
          },
          "depth_downgrade_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "depth_downgrade_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_requested": {
            "const": "standard"
          }
        },
        "required": [
          "depth_requested"
        ]
      },
      "then": {
        "properties": {
          "depth_actual": {
            "const": "standard"
          },
          "depth_downgraded": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_requested": {
            "const": "deep"
          },
          "depth_downgraded": {
            "const": false
          }
        },
        "required": [
          "depth_requested",
          "depth_downgraded"
        ]
      },
      "then": {
        "properties": {
          "depth_actual": {
            "const": "deep"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_source": {
            "const": "auto"
          }
        },
        "required": [
          "depth_source"
        ]
      },
      "then": {
        "properties": {
          "depth_actual": {
            "const": "deep"
          },
          "depth_requested": {
            "type": "null"
          },
          "depth_downgraded": {
            "const": false
          },
          "depth_downgrade_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "depth_source": {
            "const": "default"
          }
        },
        "required": [
          "depth_source"
        ]
      },
      "then": {
        "properties": {
          "depth_actual": {
            "const": "standard"
          },
          "depth_requested": {
            "type": "null"
          },
          "depth_downgraded": {
            "const": false
          },
          "depth_downgrade_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cost": {
            "properties": {
              "source": {
                "const": "unavailable"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        "required": [
          "cost"
        ]
      },
      "then": {
        "properties": {
          "cost": {
            "properties": {
              "actual_usd": {
                "type": "null"
              },
              "components": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cost": {
            "properties": {
              "source": {
                "const": "provider_reported"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        "required": [
          "cost"
        ]
      },
      "then": {
        "properties": {
          "cost": {
            "properties": {
              "actual_usd": {
                "type": "number",
                "minimum": 0
              },
              "components": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
